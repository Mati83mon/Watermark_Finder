# Environment for the Hugging Face Space.
# Set these under Settings -> Variables and secrets. TPL_API_TOKEN is a *secret*;
# the rest are plain variables.

# Shared secret the Worker sends as X-API-Key. Empty means the engine is open.
TPL_API_TOKEN=

# Limits
TPL_MAX_CHARS=200000
TPL_MAX_UPLOAD_BYTES=10485760

# Segmentation for the heatmap
TPL_WINDOW_WORDS=120
TPL_WINDOW_OVERLAP=30
TPL_MAX_SEGMENTS=300

# Browser origins allowed to call the engine directly. The Worker is the only
# real client, so this can stay narrow.
TPL_CORS_ORIGINS=*

# Optional local surprisal model. Enabling it also requires uncommenting torch
# and transformers in requirements.txt (~700 MB, slower cold starts).
TPL_ENABLE_PERPLEXITY=0
TPL_PERPLEXITY_MODEL=distilgpt2

# Optional manual-testing UI at /ui (requires gradio in requirements.txt).
TPL_ENABLE_GRADIO=0

TPL_LOG_LEVEL=INFO
